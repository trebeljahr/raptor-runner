<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store main app. The game loads only bundled files and stores its
  save in the container, so it asks for no network, file or device access.
  The app group names Electron's sandboxed IPC channels (ElectronTeamID).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
      <string>4BHY8H2J25.com.ricoslabs.raptorrunner</string>
    </array>
  </dict>
</plist>
