{
  "name": "raptor-runner",
  "private": true,
  "version": "1.1.3",
  "description": "A handcrafted homage to the Chrome 'No Internet' dinosaur game, with a full day/night cycle and a starry sky.",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "main": "electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "dev:desktop": "concurrently -k -n vite,electron -c blue,magenta \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "npm run electron:compile && wait-on http://localhost:5173 && NODE_ENV=development electron .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "csp:verify": "node scripts/verify-csp-hashes.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "icons:generate": "cd public/assets && magick icon-512.png -resize 1024x1024 icon-tmp.png && magick icon-tmp.png \\( -size 1024x1024 xc:none -fill white -draw 'roundrectangle 0,0,1023,1023,229,229' \\) -alpha set -compose DstIn -composite PNG32:icon-rounded-1024.png && magick icon-rounded-1024.png -resize 512x512 PNG32:icon-rounded-512.png && rm icon-tmp.png",
    "electron:compile": "tsc electron/main.ts electron/preload.ts --outDir electron --module CommonJS --moduleResolution node --esModuleInterop --target ES2022 --skipLibCheck",
    "electron:dev": "npm run dev:desktop",
    "build:desktop": "tsc --noEmit && cross-env VITE_TARGET=electron vite build",
    "electron:build": "npm run build:desktop && npm run electron:compile && electron-builder",
    "release:desktop": "bash scripts/release-desktop.sh",
    "preflight:signing": "bash scripts/preflight-signing.sh",
    "verify:signing": "bash scripts/verify-signing.sh",
    "electron:preview": "npm run build:desktop && npm run electron:compile && electron .",
    "icons:desktop": "mkdir -p build/icon.iconset && cp public/assets/icon-512.png build/icon.png && for sz in 16 32 64 128 256 512; do sips -z $sz $sz build/icon.png --out build/icon.iconset/icon_${sz}x${sz}.png > /dev/null; done && cp build/icon.iconset/icon_32x32.png build/icon.iconset/icon_16x16@2x.png && cp build/icon.iconset/icon_64x64.png build/icon.iconset/icon_32x32@2x.png && cp build/icon.iconset/icon_256x256.png build/icon.iconset/icon_128x128@2x.png && cp build/icon.iconset/icon_512x512.png build/icon.iconset/icon_256x256@2x.png && cp build/icon.png build/icon.iconset/icon_512x512@2x.png && iconutil -c icns build/icon.iconset -o build/icon.icns && sips -z 256 256 build/icon.png --out build/icon-256.png > /dev/null && node scripts/make-ico.mjs build/icon-256.png build/icon.ico && rm -r build/icon.iconset build/icon-256.png",
    "release:tag": "bash scripts/release-tag.sh",
    "release:tag:push": "bash scripts/release-tag.sh --push",
    "build:mobile": "tsc --noEmit && cross-env VITE_TARGET=capacitor vite build",
    "cap:sync": "npm run mobile:version && npm run build:mobile && cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "bash -c 'source scripts/android-env.sh && cap open android'",
    "cap:run:ios": "npm run cap:sync && cap run ios",
    "cap:run:android": "bash -c 'source scripts/android-env.sh && npm run build:mobile && cap sync android && cap run android'",
    "dev:android": "bash scripts/android-dev.sh",
    "dev:ios": "bash scripts/ios-dev.sh",
    "build:android:release": "bash scripts/release/build-android.sh",
    "build:android:apk": "bash scripts/release/build-android.sh",
    "build:ios:release": "bash scripts/release/build-ios.sh",
    "build:mas": "bash scripts/release/build-mas.sh",
    "android:emulator": "bash -c 'source scripts/android-env.sh && emulator -avd ${AVD:-Pixel_9_Pro} -netdelay none -netspeed full'",
    "android:kill-emulator": "bash -c 'source scripts/android-env.sh && adb emu kill'",
    "android:avds": "bash -c 'source scripts/android-env.sh && emulator -list-avds'",
    "android:devices": "bash -c 'source scripts/android-env.sh && adb devices'",
    "android:logcat": "bash -c 'source scripts/android-env.sh && adb logcat -s Capacitor Capacitor/Console Capacitor/WebView chromium'",
    "mobile:assets": "capacitor-assets generate --ios --android --iconBackgroundColor \"#50b4cd\" --splashBackgroundColor \"#50b4cd\"",
    "test:mobile-assets": "node scripts/test-mobile-assets.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "release:check": "node --test scripts/release/*.test.mjs",
    "trailer:shots": "node scripts/record-trailer-shots.mjs",
    "trailer:shots:list": "node scripts/record-trailer-shots.mjs --list",
    "trailer:render": "node scripts/render-trailer.mjs",
    "trailer:test": "node --test scripts/lib/trailer-timeline.test.mjs",
    "mobile:version": "node scripts/release/mobile-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.trebeljahr.raptor-runner",
    "productName": "Raptor Runner",
    "electronLanguages": [
      "en",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": null,
    "asarUnpack": [
      "node_modules/steamworks.js/**"
    ],
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/preload.js",
      "electron/steamInputActions.js",
      "electron/package.json",
      "public/assets/icon-rounded-1024.png",
      "node_modules/steamworks.js/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "identity": "Ricos Labs LLC (4BHY8H2J25)",
      "hardenedRuntime": true,
      "notarize": true,
      "artifactName": "Raptor-Runner-${version}-macos-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "executableName": "raptor-runner",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "Raptor-Runner-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource-variable/unbounded": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "steamworks.js": "^0.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild",
      "sharp",
      "@biomejs/biome"
    ],
    "overrides": {
      "@capacitor/assets>@capacitor/cli": "-",
      "@capacitor/assets>sharp": "0.35.4",
      "xcode>uuid": "11.1.1",
      "@rollup/plugin-terser>serialize-javascript": "7.0.5",
      "workbox-build": "7.4.1",
      "workbox-window": "7.4.1"
    }
  }
}
